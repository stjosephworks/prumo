# The port Metro serves on; `pnpm dev` moves it when it is taken.
METRO_PORT=8081

EXPO_PUBLIC_API_URL=http://localhost:3000
# prumo:google
# Google's own sheet in the app, instead of the browser, once both are set. The web client is the API's own
# GOOGLE_CLIENT_ID; the iOS client is a Google Cloud OAuth client of type "iOS" for the app's bundle identifier. Android
# needs an OAuth client of type "Android" with the app's package name and signing certificate's SHA-1, and no id here.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# prumo:end-google
