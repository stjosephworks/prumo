{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!dist", "!coverage", "!src/routeTree.gen.ts"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": { "rules": { "preset": "recommended" } },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "asNeeded" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "overrides": [
    {
      "includes": ["src/components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            // A shadcn primitive forwards htmlFor through props, which the rule cannot see.
            "noLabelWithoutControl": "off",
            // shadcn's Field uses role="group" on purpose; a fieldset would change layout and semantics.
            "useSemanticElements": "off"
          }
        }
      }
    }
  ]
}
