{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    // The API runs this file through Node's type stripping, which erases types and rewrites nothing.
    "erasableSyntaxOnly": true,
    "noEmit": true
  },
  "include": ["src"]
}
