---
import { SignInWays } from '@/features/auth/sign-in-choice'
import { SocialSignIn } from '@/features/auth/social-buttons' // prumo:social
import type { Locale } from '@/i18n/locales'
import { messagesFor } from '@/i18n/messages'
import { localePaths } from '@/i18n/pages'
import Narrow from '@/layouts/narrow.astro'

export function getStaticPaths() {
  return localePaths()
}

const { locale } = Astro.props as { locale: Locale }
const messages = messagesFor(locale)
---

<Narrow title={messages.auth.signIn.title} locale={locale}>
  <h1 class="text-2xl font-semibold">{messages.auth.signIn.title}</h1>
  {/* prumo:social */}
  <SocialSignIn client:only="react" locale={locale} />
  {/* prumo:end-social */}
  <SignInWays client:only="react" locale={locale} />
</Narrow>
