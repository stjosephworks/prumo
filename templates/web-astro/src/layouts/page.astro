---
import '@/styles/global.css'

type Props = {
  title: string
  // What a search result shows under the title; a page left out of search needs none.
  description?: string
  index?: boolean
}

const { title, description, index = true } = Astro.props
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {!index && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <slot />
  </body>
</html>
