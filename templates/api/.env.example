NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Who may name the client's address in X-Forwarded-For, which the rate limits read. false trusts nobody: right with no
# proxy in front. Behind a load balancer, its IPs or CIDRs, comma-separated; true only where nothing but the
# platform's proxy can reach the API, or a client can choose its own address.
TRUST_PROXY=false

# MISSING until `pnpm db:setup` creates a database; `pnpm dev` offers to run it.
DATABASE_URL=MISSING
# Read by docker-compose.yml, not by the API: the port Postgres is published on.
POSTGRES_PORT=5432

# Signs the access tokens. `prumo new` writes a random one into .env; never reuse it between environments.
JWT_SECRET=replace-this-with-at-least-32-characters
API_URL=http://localhost:3000
# Every web app the API answers, comma-separated. The first is where MCP consent opens.
WEB_ORIGIN=http://localhost:5173
# prumo:social
# The mobile app's scheme, as in app.json: where it is sent back after signing in with a provider.
MOBILE_APP_SCHEME=app
# prumo:end-social
# prumo:google
# From a Google Cloud OAuth client of type "Web application", with this redirect URI authorised:
# http://localhost:3000/api/auth/social/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# prumo:end-google
# prumo:apple
# From an Apple Services ID with Sign in with Apple and a key for it. Register this return URL on the Services ID,
# with the address Apple can reach your API at: <API_URL>/api/auth/social/apple/callback
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# prumo:end-apple
# prumo:phone-code
# The countries a sign-in text may go to, ISO 3166 codes, comma-separated. Set it to where the product's users are
# before going live: a text to anywhere is a bill an attacker runs up. +44 numbers may be GB, GG, IM or JE.
SMS_COUNTRIES=US
# prumo:end-phone-code
