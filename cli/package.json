{
  "name": "@stjoseph/prumo",
  "version": "0.1.0",
  "description": "Scaffolds a TypeScript project and ships it the conventions it follows, in a .prumo/ folder any AI assistant reads.",
  "keywords": [
    "scaffolding",
    "cli",
    "typescript",
    "fastify",
    "mcp",
    "expo",
    "monorepo",
    "conventions",
    "agents",
    "ai"
  ],
  "homepage": "https://github.com/stjosephworks/prumo#readme",
  "bugs": "https://github.com/stjosephworks/prumo/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stjosephworks/prumo.git",
    "directory": "cli"
  },
  "license": "MIT",
  "author": "Leonardo Freitas",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "bin": {
    "prumo": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    ".prumo-templates"
  ],
  "scripts": {
    "lint": "biome check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir test",
    "prumo": "node src/cli.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "24.13.4",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
